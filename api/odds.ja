export default async function handler(req, res) {
  const league = req.query.league || 'soccer_epl';
  const key = '3ff3c5ffc1f3049807f3590b29d6e2b1';
  if (!key) return res.status(500).json({ error: 'ODDS_API_KEY missing' });

  try {
    const url = `https://api.the-odds-api.com/v4/sports/${league}/odds/?apiKey=${key}&regions=eu&markets=h2h&oddsFormat=decimal`;
    const r = await fetch(url);
    if (!r.ok) throw new Error(`Odds API ${r.status}`);
    const data = await r.json();
    res.setHeader('Cache-Control', 's-maxage=60, stale-while-revalidate=120');
    return res.status(200).json(data);
  } catch (err) {
    return res.status(500).json({ error: err.message });
  }
}
